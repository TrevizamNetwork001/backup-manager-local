[Unit]
Description=Backup Manager SQLite guard and recovery
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/opt/backup-manager-local
ExecStart=/usr/bin/python3 /opt/backup-manager-local/scripts/database-guard.py --recover
User=root
Group=root
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/backup-manager-local/data

